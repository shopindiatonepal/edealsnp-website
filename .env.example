# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for /admin login (pick your own)
ADMIN_PASSWORD=change-me

# Store contact info
STORE_EMAIL=edealsnp@gmail.com

# --- Order confirmation email (optional — orders work fine without this) ---
# Free account at resend.com. RESEND_FROM must be on a domain you've
# verified with Resend (their docs walk through it in a few minutes).
RESEND_API_KEY=
RESEND_FROM=Edeals NP <orders@yourdomain.com>

# --- Order confirmation on WhatsApp (optional) ---
# From a Meta developer app with the WhatsApp product added:
# developers.facebook.com -> your app -> WhatsApp -> API Setup.
# WHATSAPP_TEMPLATE_NAME is only needed for messages to customers who
# haven't messaged your number in the last 24 hours — see lib/notify.js.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=

# Your own WhatsApp number (with country code, no + or spaces) to get a
# WhatsApp alert every time a new order comes in. Needs the two WhatsApp
# variables above set too.
STORE_WHATSAPP_NUMBER=9779845522014
